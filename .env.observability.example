OTEL_COLLECTOR_LISTEN_ADDRESS=0.0.0.0:4318
# Keep percentage (0..100) for traces without ERROR spans and below the slow threshold.
# Keep 100 for now; logs/metrics are not sampled.
OTEL_COLLECTOR_TRACES_SAMPLING_PERCENTAGE=100
# Tail-sampling latency threshold in milliseconds, matching the processor setting (1000 = 1 second).
OTEL_COLLECTOR_TRACES_SLOW_THRESHOLD_MS=1000
# Copy to .env.observability (ignored). Only the Collector receives this file.
# Use the Grafana Cloud portal's OpenTelemetry connection details, not the Loki username.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://REPLACE.grafana.net/otlp
# Authorization header value only: Basic <base64(instance-id:token)>, without Authorization=.
GRAFANA_CLOUD_OTLP_HEADERS='Basic REPLACE_WITH_BASE64_INSTANCE_ID_COLON_TOKEN'

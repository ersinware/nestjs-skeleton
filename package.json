{
    "name": "nestjs-skeleton",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "docker:dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
        "docker:dev:up:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
        "docker:dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
        "docker:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
        "docker:dev:down:clean": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v",
        "docker:prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
        "docker:prod:up:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build",
        "docker:prod:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f",
        "docker:prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
        "docker:prod:down:clean": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down -v",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "test:debug": "vitest --inspect-brk --no-file-parallelism --runInBand",
        "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
        "prepare": "husky",
        "start:wait": "node dist/main.js & wait-on http://localhost:3000/api/health -t 30000",
        "check:shadow-api": "if grep -rE --exclude-dir=node_modules --exclude-dir=dist \"(@ApiExcludeEndpoint\\(true\\)|@Controller\\('_dev'\\))\" .; then echo \"Shadow API found!\"; exit 1; else echo \"No Shadow API found.\"; fi",
        "format": "prettier --write --cache --cache-location .prettiercache --ignore-unknown .",
        "format:check": "prettier --check --cache --cache-location .prettiercache .",
        "lint": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint . --cache --max-warnings 0 --no-warn-ignored",
        "lint:fix": "NODE_OPTIONS=\"--max-old-space-size=4096\" eslint . --fix --cache --max-warnings 0 --no-warn-ignored",
        "test:type": "tsc --noEmit --incremental",
        "build:doc": "ts-node --transpile-only -r tsconfig-paths/register script/build-doc.ts",
        "build:client": "npm run build:doc && openapi-typescript dist/docs/swagger-v1.json -o dist/docs/api-client.ts",
        "build:ci": "npm run build && npm run build:client",
        "lint:contract": "spectral lint dist/docs/swagger-v1.json --ruleset .spectral.yml",
        "test:contract": "schemathesis run dist/docs/swagger-v1.json --url http://localhost:3000 --checks not_a_server_error --suppress-health-check=filter_too_much",
        "audit": "audit-ci --high",
        "ci:local": "act --artifact-server-path ./.act-artifacts --env-file .env.test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-fastify": "^11.1.21",
        "@nestjs/swagger": "^11.4.3",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/throttler": "^6.5.0",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.77.0",
        "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
        "@opentelemetry/host-metrics": "^0.39.0",
        "@opentelemetry/sdk-metrics": "^2.8.0",
        "@opentelemetry/sdk-node": "^0.219.0",
        "@scalar/nestjs-api-reference": "^1.1.14",
        "@sentry/nestjs": "^10.57.0",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "drizzle-orm": "^0.45.2",
        "fastify": "5.8.5",
        "googleapis": "^173.0.0",
        "ioredis": "^5.10.1",
        "nestjs-pino": "^4.6.1",
        "pino-http": "^11.0.0",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@stoplight/spectral-cli": "^6.16.0",
        "@swc/cli": "^0.8.1",
        "@swc/core": "^1.10.1",
        "@types/node": "^24.0.0",
        "@types/supertest": "^7.0.0",
        "@vitest/coverage-v8": "^4.1.8",
        "audit-ci": "^7.1.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^6.0.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "openapi-typescript": "^7.0.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "supertest": "^7.0.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "unplugin-swc": "^1.5.1",
        "vitest": "^4.1.8",
        "wait-on": "^9.0.10"
    },
    "overrides": {
        "esbuild": "0.28.1",
        "js-yaml": "^4.2.0"
    }
}

# --- App ---
PORT=3000
NODE_ENV=development
# "false" (no proxy), or the trusted proxy IPs/CIDRs (e.g. 10.0.0.0/8,192.168.0.0/16).
# Never "true", and never a hop count: both resolve the client IP from an untrusted position.
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db
DATABASE_POOL_SIZE=25
DATABASE_CONNECT_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=30
DATABASE_MAX_LIFETIME=1800

# --- Redis ---
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=password
REDIS_CACHE_TLS=false
REDIS_SESSION_HOST=redis-session
REDIS_SESSION_PORT=6379
REDIS_SESSION_PASSWORD=password
REDIS_SESSION_TLS=false
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_COMMAND_TIMEOUT=5000

# --- Auth ---
JWT_ACCESS_SECRET=access_secret_key
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=refresh_secret_key
JWT_REFRESH_TTL=7d
JWT_INVITE_SECRET=invite_secret_key
JWT_INVITE_TTL=3d
ADMIN_INVITE_URL=https://your-admin-frontend.example.com/activate
SESSION_ROTATION_GRACE_TTL=30s

# --- Health ---
HEALTH_HEAP_LIMIT_MB=600
HEALTH_RSS_LIMIT_MB=800

# --- Email (Gmail) ---
GMAIL_USER_EMAIL=your-gmail-user-email@gmail.com
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# --- Sentry ---
SENTRY_DSN=https://placeholder@sentry.io/123456
SENTRY_ENVIRONMENT=development

# --- OpenTelemetry (app) ---
# The app's only telemetry destination; where the collector ships from there is its own config.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_SERVICE_NAME=nestjs-skeleton
# Resource attributes beside the service name: the namespace groups the services of one product,
# the environment separates deployments. Both are promoted to labels by the metrics store.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=nestjs-skeleton,deployment.environment.name=development
# Stable HTTP semantic conventions: `http.route` on spans, `http_server_request_duration_seconds`.
OTEL_SEMCONV_STABILITY_OPT_IN=http
# Head sampling stays at 100%: tail sampling in the collector needs every trace to judge it on its
# outcome, so lowering these would silently defeat the tail policies.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

# --- Collector (read by the collector container, not the app) ---
# 100 keeps every trace; lower it to sample ordinary traffic. Errors and slow traces are always kept.
OTEL_TAIL_SAMPLING_PERCENTAGE=100
# Where the collector ships each signal. Local: the three stores, no auth. Grafana Cloud: the OTLP
# gateway for all three, Authorization = `Basic <base64 instance:token>`.
OTEL_COLLECTOR_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_COLLECTOR_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
OTEL_COLLECTOR_LOGS_ENDPOINT=http://loki:3100/otlp/v1/logs
OTEL_COLLECTOR_AUTHORIZATION=
# Soft limit (new data refused), spike allowance (GC forced past soft + spike), and the container's
# own limit, which must exceed their sum with headroom for the runtime.
OTEL_COLLECTOR_MEMORY_LIMIT_MIB=400
OTEL_COLLECTOR_MEMORY_SPIKE_LIMIT_MIB=100
OTEL_COLLECTOR_CONTAINER_MEMORY_MIB=512

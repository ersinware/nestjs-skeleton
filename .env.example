PORT=3000
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/db
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=30
DATABASE_MAX_LIFETIME=1800

HEALTH_HEAP_LIMIT_MB=600
HEALTH_RSS_LIMIT_MB=800

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_COMMAND_TIMEOUT=5000

JWT_ACCESS_SECRET=access_secret_key_development_only_change_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=refresh_secret_key_development_only_change_in_prod
JWT_REFRESH_TTL=7d

PORT=3000
NODE_ENV=test

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=30
DATABASE_MAX_LIFETIME=1800

REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_TLS=false
REDIS_STATE_HOST=127.0.0.1
REDIS_STATE_PORT=6380
REDIS_STATE_PASSWORD=
REDIS_STATE_TLS=false
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_COMMAND_TIMEOUT=5000

JWT_ACCESS_SECRET=access_secret_key_test_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=refresh_secret_key_test_only
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_CRITICAL_TTL=60000
THROTTLE_CRITICAL_LIMIT=5

HEALTH_HEAP_LIMIT_MB=600
HEALTH_RSS_LIMIT_MB=800

GMAIL_USER_EMAIL=gmail_user_email@gmail.com
GMAIL_CLIENT_ID=gmail_client_id
GMAIL_CLIENT_SECRET=gmail_client_secret
GMAIL_REFRESH_TOKEN=gmail_refresh_token

SENTRY_DSN=https://placeholder@sentry.io/123456
SENTRY_ENVIRONMENT=test

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
OTEL_SERVICE_NAME=nestjs-skeleton
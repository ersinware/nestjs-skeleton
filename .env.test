PORT=3000
NODE_ENV=test
# "false" (no proxy), or the trusted proxy IPs/CIDRs (e.g. 10.0.0.0/8,192.168.0.0/16).
# Never "true", and never a hop count: both resolve the client IP from an untrusted position.
TRUST_PROXY=false

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_POOL_SIZE=25
DATABASE_CONNECT_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=30
DATABASE_MAX_LIFETIME=1800

REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_TLS=false
REDIS_STATE_HOST=127.0.0.1
REDIS_STATE_PORT=6380
REDIS_STATE_PASSWORD=
REDIS_STATE_TLS=false
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_COMMAND_TIMEOUT=5000

JWT_ACCESS_SECRET=access_secret_key_test_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=refresh_secret_key_test_only
JWT_REFRESH_TTL=7d
SESSION_ROTATION_GRACE_TTL=30s

# All throttle durations are MILLISECONDS.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300
THROTTLE_BLOCK_DURATION=60000
THROTTLE_CRITICAL_BURST_TTL=60000
THROTTLE_CRITICAL_BURST_LIMIT=10
THROTTLE_CRITICAL_BURST_BLOCK_DURATION=60000
THROTTLE_CRITICAL_SUSTAINED_TTL=3600000
THROTTLE_CRITICAL_SUSTAINED_LIMIT=60
THROTTLE_CRITICAL_SUSTAINED_BLOCK_DURATION=3600000

HEALTH_HEAP_LIMIT_MB=600
HEALTH_RSS_LIMIT_MB=800

GMAIL_USER_EMAIL=gmail_user_email@gmail.com
GMAIL_CLIENT_ID=gmail_client_id
GMAIL_CLIENT_SECRET=gmail_client_secret
GMAIL_REFRESH_TOKEN=gmail_refresh_token

SENTRY_DSN=https://placeholder@sentry.io/123456
SENTRY_ENVIRONMENT=test

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
OTEL_SERVICE_NAME=nestjs-skeleton
# --- Trace sampling ---
# Two mechanisms are wired, but only ONE decides: TAIL sampling, in the otel-collector.
# HEAD sampling (the two vars below) is therefore pinned to full and MUST NOT be changed. Tail
# sampling requires the app to export 100% of its traces so the collector can judge each COMPLETED
# trace on its outcome; turning head sampling down here would starve the collector and silently
# defeat the tail policies. Leave these exactly as-is.
# (In test the OTel SDK never starts, so these are inert — kept only to mirror .env/.env.example.)
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
# The actual knob — read by the otel-collector container (compose), NOT the app. 100 = keep every
# trace (tail sampling OFF); lower it (e.g. 10) to sample ordinary traffic. Errors and slow traces
# are ALWAYS kept regardless. This is the only sampling value you should change.
OTEL_TAIL_SAMPLING_PERCENTAGE=100
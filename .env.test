# Numeric app durations are seconds; string TTLs include their unit (s/m/h/d).
# --- App ---
PORT=3000
NODE_ENV=test
# "false" (no proxy), or the trusted proxy IPs/CIDRs (e.g. 10.0.0.0/8,192.168.0.0/16).
# Never "true", and never a hop count: both resolve the client IP from an untrusted position.
TRUST_PROXY=false

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Optional read replica (e.g. an Aurora reader endpoint). Empty: replica-bound reads run on the primary.
DATABASE_REPLICA_URL=
DATABASE_POOL_SIZE=15
# Per-process replica limit; omit to use DATABASE_POOL_SIZE. Unused without a replica URL.
DATABASE_REPLICA_POOL_SIZE=10
# Database timeouts and connection lifetime are in seconds.
DATABASE_CONNECT_TIMEOUT=2
DATABASE_STATEMENT_TIMEOUT=4
DATABASE_QUERY_TIMEOUT=5
DATABASE_IDLE_TIMEOUT=30
DATABASE_MAX_LIFETIME=1800

# --- Job Queue ---
# Connection limit for each independent pg-boss pool per process.
JOB_QUEUE_POOL_SIZE=20
# Enable on the designated monitoring instance; disable on other instances.
JOB_QUEUE_DLQ_MONITOR_ENABLED=true
# Interval in seconds between completed DLQ monitoring samples.
JOB_QUEUE_DLQ_SAMPLE_INTERVAL=60

# --- Redis ---
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=
REDIS_CACHE_TLS=false
REDIS_CACHE_MAX_RETRIES_PER_REQUEST=0
REDIS_CACHE_COMMAND_TIMEOUT=0.1
REDIS_SESSION_HOST=127.0.0.1
REDIS_SESSION_PORT=6380
REDIS_SESSION_PASSWORD=
REDIS_SESSION_TLS=false
REDIS_SESSION_MAX_RETRIES_PER_REQUEST=1
REDIS_SESSION_COMMAND_TIMEOUT=0.5

# --- Auth ---
# Fixed lifetime of a login; refresh never extends this deadline.
SESSION_ABSOLUTE_TTL_ADMIN=8h
SESSION_ABSOLUTE_TTL_USER=7d
# Replay grace: 1–60 seconds, with an explicit unit (e.g. 10s, 30s, 1m).
SESSION_ROTATION_GRACE_TTL=10s
# JWT secrets must be at least 32 UTF-8 bytes; the placeholders below fail boot validation.
# Generate a separate random secret for each token type and environment: openssl rand -hex 32
# Paste the output as-is (secrets are used as UTF-8 text, not hex-decoded).
JWT_ACCESS_SECRET=4f0224395dc86c52360a38838d710650fead0f60dcdb5f8411478c6d5125a84f
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=776bd7d9e2c7bc20a2d7dc0252588df92818eecf7f80799056f4cfe1e4394fca
JWT_REFRESH_TTL=7d
JWT_INVITE_SECRET=899ddef008df81d1e9fc820364041c89b0f781518d7c0837ca761352d852dda1
JWT_INVITE_TTL=3d
ADMIN_INVITE_URL=http://localhost:3001/admin/activate

# --- Health ---
HEALTH_HEAP_LIMIT_MB=600
HEALTH_RSS_LIMIT_MB=800

# --- Email (Gmail) ---
GMAIL_USER_EMAIL=gmail_user_email@gmail.com
GMAIL_CLIENT_ID=gmail_client_id
GMAIL_CLIENT_SECRET=gmail_client_secret
GMAIL_REFRESH_TOKEN=gmail_refresh_token

# --- Sentry ---
SENTRY_DSN=https://placeholder@sentry.io/123456
SENTRY_ENVIRONMENT=test

# --- OpenTelemetry (app) ---
# The app's only telemetry destination; where the collector ships from there is its own config.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_SERVICE_NAME=nestjs-skeleton
# Resource attributes beside the service name: the namespace groups the services of one product,
# the environment separates deployments. Both are promoted to labels by the metrics store.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=nestjs-skeleton,deployment.environment.name=test
# Generate a fresh service.instance.id per SDK startup; preserve environment/host/process attributes.
OTEL_NODE_RESOURCE_DETECTORS=env,host,process,serviceinstance
# Stable HTTP semantic conventions: `http.route` on spans, `http_server_request_duration_seconds`.
OTEL_SEMCONV_STABILITY_OPT_IN=http
